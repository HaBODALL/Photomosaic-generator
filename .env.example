# API Keys and Credentials configuration
# Copy this file to .env and fill in your values

# Unsplash API Access Key
UNSPLASH_ACCESS_KEY=

# Pexels API Key
PEXELS_API_KEY=

# Pixabay API Key
PIXABAY_API_KEY=

# Immich Instance Configuration
IMMICH_HOST_URL=http://localhost:2283
IMMICH_API_KEY=

# Google Photos OAuth Token
GOOGLE_PHOTOS_ACCESS_TOKEN=

# WebDAV / Nextcloud Configuration
WEBDAV_URL=
WEBDAV_USERNAME=
WEBDAV_PASSWORD=
